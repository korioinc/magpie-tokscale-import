{
  "name": "magpie-tokscale-import",
  "version": "0.1.3",
  "description": "Submit daily Magpie usage snapshots directly to Tokscale.",
  "type": "module",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./server": "./index.mjs"
  },
  "bin": {
    "magpie-tokscale-import": "./cli.mjs"
  },
  "magpie": {
    "icon": "data:image/webp;base64,"
  },
  "files": [
    "assets/icon.webp",
    "index.mjs",
    "cli.mjs",
    "lib/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22",
    "bun": ">=1.1.0"
  },
  "scripts": {
    "test": "node --test",
    "check": "node --check index.mjs && node --check cli.mjs && node --check lib/config.mjs && node --check lib/aggregate.mjs && node --check lib/state.mjs && node --check lib/transport.mjs && node --check lib/worker.mjs && node --check lib/reconcile.mjs && node --check lib/scheduler.mjs"
  },
  "dependencies": {
    "proper-lockfile": "^4.1.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/korioinc/magpie-tokscale-import.git"
  },
  "keywords": [
    "magpie",
    "tokscale",
    "opencode",
    "usage",
    "tokens"
  ]
}
